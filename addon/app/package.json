{
  "name": "kindledash-renderer",
  "version": "0.2.0",
  "private": true,
  "description": "Renders a Home Assistant dashboard into an e-ink friendly PNG for a jailbroken Kindle.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.37.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
