# Copy to .env (gitignored). Used by compose.yaml for local development of the
# renderer against a Home Assistant instance without HAOS.

# Base URL Home Assistant really listens on, as seen from this machine (no trailing
# slash). This instance runs on port 80; the HA default would be http://host:8123.
# Leave empty to auto-detect (Supervisor, then homeassistant:8123 / :80 probes).
KD_HA_URL=http://10.3.0.104
# Long-lived access token: HA -> profile -> Security -> Long-lived access tokens.
KD_ACCESS_TOKEN=
# Lovelace dashboard path to render.
KD_DASHBOARD_PATH=/dashboard-test-2
# Optional query string appended to the dashboard URL, e.g. ?kiosk
KD_URL_QUERY=
# Dashboard viewport: Kindle Oasis landscape (portrait would be 1264 x 1680).
KD_WIDTH=1680
KD_HEIGHT=1264
# Rotate the finished PNG clockwise: 0, 90, 180 or 270. The Oasis framebuffer is
# portrait, so a landscape viewport needs 90 (270 flips it for the other hand).
KD_ROTATION=90
# CSS zoom applied to the page (1.0 = 100%).
KD_ZOOM=1.0
# Re-render interval in seconds.
KD_INTERVAL=60
# Extra wait after the dashboard loaded, in milliseconds (cards finish rendering).
KD_RENDER_DELAY_MS=1500
# light or dark
KD_COLOR_SCHEME=light
# Optional HA theme name and UI language.
KD_THEME=
KD_LANGUAGE=
# Hide the Lovelace header bar and sidebar.
KD_HIDE_HEADER=true
# e-ink post-processing: number of gray levels (Kindle: 16), dithering, contrast (1.0 = unchanged).
KD_GRAY_LEVELS=16
KD_DITHER=true
KD_CONTRAST=1.15
# Optional token protecting GET /kindle.png, /status and POST /render.
KD_SERVER_TOKEN=
# HTTP port inside the container (compose maps it to the host).
KD_PORT=8080
# Screenshot of the last failed render (empty disables). Served at /last-error.png.
KD_ERROR_SCREENSHOT=/data/last-error.png
